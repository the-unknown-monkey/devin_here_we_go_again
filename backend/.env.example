# HWGA backend configuration — copy to .env and fill in real values.
# Only variable NAMES are committed; never commit real values.

# Dev Postgres (docker-compose `db`, host port 55532)
DATABASE_URL=postgresql+psycopg://hwga:hwga@127.0.0.1:55532/hwga

# Disposable test Postgres (docker-compose `db-test`, host port 55533).
# Tests refuse to run if this equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://hwga:hwga@127.0.0.1:55533/hwga_test

# Backend-owned media root. Never exposed as static files.
MEDIA_STORAGE_ROOT=data/media

# Hashing secret (pepper) for bootstrap-CLI-issued bearer tokens. Required.
AUTH_TOKEN_PEPPER=change-me-generate-a-long-random-string

# IANA timezone for the single user (D20)
USER_TIMEZONE=Asia/Kolkata

# Server-side Gemini key — configured only when agent phases need it.
# GEMINI_API_KEY=

# In-process APScheduler nightly job (D21); off by default in dev/tests.
SCHEDULER_ENABLED=false
